{
  "name": "parser",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "watch": "tsc --build --watch",
    "test": "pnpm build && pnpm -r --workspace-concurrency=1 test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,yml,yaml,md}\"",
    "release": "pnpm build && pnpm changeset publish",
    "ncu": "ncu -u && pnpm -r exec ncu -u"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.5",
    "prettier": "3.9.6",
    "typescript": "^7.0.2",
    "npm-check-updates": "^23.1.0"
  }
}
